<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app2="http://schemas.android.com/apk/res-auto">

    <mc.snakenest.launcher.android.prefs.BackButtonPreference/>

    <PreferenceCategory android:title="@string/preference_category_java_tweaks">
        <Preference
            android:key="install_jre"
            android:persistent="false"
            android:summary="@string/multirt_subtitle"
            android:title="@string/multirt_title"/>

        <androidx.preference.EditTextPreference
            android:dialogTitle="@string/sn3_global_arguments_title"

            android:key="javaArgs"
            android:singleLine="true"
            android:summary="@string/sn3_global_arguments_summary"
            android:title="@string/sn3_global_arguments_title" />

        <mc.snakenest.launcher.android.prefs.CustomSeekBarPreference
            android:key="allocation"

            android:summary="@string/sn3_global_memory_summary"
            android:title="@string/sn3_global_memory_title"
            app2:showSeekBarValue="true"
            app2:min="@integer/memory_seekbar_min"
            app2:seekBarIncrement="@integer/memory_seekbar_increment"
            app2:selectable="false"/>

        <SwitchPreference
            android:defaultValue="false"
            android:key="disable_autojre_select"
            android:title="Disable automatic JRE selection"
            />
            
    </PreferenceCategory>


</PreferenceScreen>